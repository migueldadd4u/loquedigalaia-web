{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loquedigalaia.com/schema/pulso.schema.json",
  "title": "Pulso diario publicado por un clon",
  "type": "object",
  "additionalProperties": false,
  "required": ["clone", "asOf", "indicators"],
  "properties": {
    "clone": {
      "type": "string",
      "enum": ["clonmadv3", "jarvis"]
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "indicators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "value", "unit", "asOf", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "maxLength": 80 },
          "value": { "type": "number" },
          "unit": { "type": "string", "maxLength": 20 },
          "asOf": { "type": "string", "format": "date" },
          "source": { "type": "string", "maxLength": 120 },
          "monotonic": { "type": "boolean", "default": false }
        }
      }
    }
  }
}
